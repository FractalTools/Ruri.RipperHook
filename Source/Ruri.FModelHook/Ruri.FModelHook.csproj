<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Ruri.FModelHook</AssemblyName>
    <!-- This assembly is loaded as a MODULE beside a host that never referenced its packages, so
         the packages have to sit next to it rather than be resolved from the host's graph. The
         runtime identifier is what makes a package's NATIVE half resolve at all; the output path
         above already names that same platform. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ruri.Hook\Ruri.Hook.csproj" />
    <ProjectReference Include="..\Ruri.ShaderDecompiler\Ruri.ShaderDecompiler.csproj" />
    <!-- The Ripper side of this assembly (Ripper/): the Unreal decoder every RipperHook host
         loads as a module, converting Unreal packages into Unity assets through the kernel's
         engine-neutral builders. The kernel never references the Unreal stack; this assembly
         references the kernel. -->
    <ProjectReference Include="..\Ruri.RipperHook\Ruri.RipperHook.csproj" />
    <ProjectReference Include="..\..\FModel\FModel\FModel.csproj" />
    <ProjectReference Include="..\..\FModel\CUE4Parse\CUE4Parse\CUE4Parse.csproj" />
    <ProjectReference Include="..\..\FModel\CUE4Parse\CUE4Parse-Conversion\CUE4Parse-Conversion.csproj" />
  </ItemGroup>
	
  <!-- The Unreal half of the private Ruri.GameHook submodule: what a studio does to its own
       archives that the engine itself does not, namely which container dialect it cooked with,
       where it publishes the keys that open it, and which files on disk prove an install is
       that title. It compiles HERE and not into the kernel because reading an Unreal archive is
       CUE4Parse's job and this is the only project that may reference it. Everything an
       unencrypted stock Unreal build needs lives in FModelHook/BlenderBridge instead. -->
  <ItemGroup Condition="'$(PureRelease)' != 'true'">
    <Compile Include="..\Ruri.GameHook\Unreal\**\*.cs" Link="Ruri.GameHook\Unreal\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoMod.RuntimeDetour" Version="25.3.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>

  <!-- Engine UB seed metadata. One JSON per <UBName>_<LayoutHash:08x>
       pair, loaded at startup by EngineUbMetadataLoader from
       <exeDir>/EngineUbMetadata/ (recursive). Source layout groups by
       UE version (UE5.1.1/, UE5.4.4/, ...) but the loader keys by
       (UBName, LayoutHash) regardless of subfolder.

       Copy is "first-run only": files are copied only when the
       destination doesn't already exist. This preserves user edits and
       hand-added JSONs at the deployed location across rebuilds — git
       pull + dotnet build will NOT clobber local symbol overrides. To
       force-refresh, delete the deployed file. -->
  <ItemGroup>
    <_EngineUbMetadataSeed Include="EngineUbMetadata\**\*" />
  </ItemGroup>

  <Target Name="CopyEngineUbMetadataIfMissing" AfterTargets="Build">
    <Copy SourceFiles="@(_EngineUbMetadataSeed)" DestinationFiles="@(_EngineUbMetadataSeed->'$(OutputPath)EngineUbMetadata\%(RecursiveDir)%(Filename)%(Extension)')" Condition="!Exists('$(OutputPath)EngineUbMetadata\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- The kernel finds this module by the declaration this build leaves beside it
       (Bootstrap.LoadDeclaredModules). Kernel and module share one output folder, so the
       declaration names a sibling and no host has to be told where the decoder went. -->
  <Target Name="DeclareModuleToKernel" AfterTargets="Build">
    <MakeDir Directories="$(OutputPath)Modules" />
    <WriteLinesToFile File="$(OutputPath)Modules\$(AssemblyName).module" Lines="$(TargetPath)" Overwrite="true" />
  </Target>

</Project>
