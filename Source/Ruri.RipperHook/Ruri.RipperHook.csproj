<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<OutputPath>..\..\AssetRipper\Source\0Bins\AssetRipper\$(Configuration)\</OutputPath>
		<IntermediateOutputPath>..\..\AssetRipper\Source\0Bins\obj\AssetRipper\$(Configuration)\</IntermediateOutputPath>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<AssemblyName>Ruri.RipperHook</AssemblyName>
		<TargetFramework>net10.0-windows</TargetFramework>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<InternalsAssemblyNames>AssetRipper.SourceGenerated;AssetRipper.Export.Modules.Models;Ruri.ShaderDecompiler</InternalsAssemblyNames>
		<CompileUsingReferenceAssemblies>false</CompileUsingReferenceAssemblies>
		<Configurations>Debug;Release</Configurations>
	</PropertyGroup>

	<PropertyGroup>
		<CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
	</PropertyGroup>

	<PropertyGroup Condition="'$(PureRelease)' == 'true'">
		<Optimize>true</Optimize>
		<DefineConstants>$(DefineConstants);TRACE;RURI_PURE_RELEASE</DefineConstants>
	</PropertyGroup>

	<ItemGroup Condition="'$(PureRelease)' == 'true'">
		<Compile Remove="AssetRipperGameHook\**\*.cs" />
		<EmbeddedResource Remove="AssetRipperGameHook\**\*" />
		<None Remove="AssetRipperGameHook\**\*" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AsmResolver.DotNet" Version="6.0.1" />
		<PackageReference Include="AsmResolver.PE.File" Version="6.0.1" />
		<PackageReference Include="AssetRipper.Checksum" Version="1.1.0" />
		<!-- Pins the whole graph to the tpk container format the packer writes. AssetRipper's own
		     projects still ask for 1.2.0 while its AssemblyDumper is already on 2.0.0; NuGet resolves
		     to the highest, and declaring it here rather than editing the submodule keeps AssetRipper
		     at a pristine upstream checkout. The two payloads that the published SourceGenerated
		     package froze at format 1 are served from our own files instead: see TypeTreeFallbackHook
		     and EngineAssetsTpkHook. -->
		<PackageReference Include="AssetRipper.Tpk" Version="2.0.0" />
		<!-- IL2CPP native-method disassembly (AR_Il2CppMethodDump). Same versions AssetRipper.Import / .Export pull. -->
		<PackageReference Include="AssetRipper.Cpp2IL.Core" Version="1.0.8" />
		<PackageReference Include="AssetRipper.ICSharpCode.Decompiler" Version="11.0.0.9313-rc" />
		<!-- Real Iced (x86 decode for the loc_ listing). Aliased: MonoMod.Iced (via MonoMod.RuntimeDetour) also exposes Iced.Intel. -->
		<PackageReference Include="Iced" Version="1.21.0" Aliases="icedreal" />
		<PackageReference Include="AssetsTools.NET" Version="3.0.2" />
		<PackageReference Include="IgnoresAccessChecksToGenerator" Version="0.8.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="MonoMod.RuntimeDetour" Version="25.3.3" />
		<PackageReference Include="Oodle.NET" Version="2.2.0" />
		<PackageReference Include="Google.FlatBuffers" Version="25.2.10" />
	</ItemGroup>

	<ItemDefinitionGroup Condition="'$(PureRelease)' == 'true'">
		<ProjectReference>
			<SetConfiguration>Configuration=Release</SetConfiguration>
		</ProjectReference>
	</ItemDefinitionGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\AssetRipper\Source\AssetRipper.Assets\AssetRipper.Assets.csproj" />
		<ProjectReference Include="..\..\AssetRipper\Source\AssetRipper.Export.UnityProjects\AssetRipper.Export.UnityProjects.csproj" />
		<ProjectReference Include="..\..\AssetRipper\Source\AssetRipper.GUI.Web\AssetRipper.GUI.Web.csproj" />
		<ProjectReference Include="..\..\AssetRipper\Source\AssetRipper.IO.Files\AssetRipper.IO.Files.csproj" />
		<ProjectReference Include="..\..\AssetRipper\Source\AssetRipper.Numerics\AssetRipper.Numerics.csproj" />
		<ProjectReference Include="..\..\AssetRipper\Source\AssetRipper.SerializationLogic\AssetRipper.SerializationLogic.csproj" />
		<ProjectReference Include="..\..\AssetRipper\Source\AssetRipper.SourceGenerated.Extensions\AssetRipper.SourceGenerated.Extensions.csproj" />
		<ProjectReference Include="..\..\AssetRipper\Source\AssetRipper.Yaml\AssetRipper.Yaml.csproj" />
		<ProjectReference Include="..\Ruri.ShaderDecompiler\Ruri.ShaderDecompiler.csproj" />
		<ProjectReference Include="..\Ruri.Hook\Ruri.Hook.csproj" />
		<ProjectReference Include="..\Ruri.ACL\Ruri.ACL.csproj" />
	</ItemGroup>

	<!-- The game type trees, interpreted at runtime by Ruri.RipperHook.Core.TypeTree. They live with
	     the game hooks they describe, so PureRelease strips them along with the rest of that tree
	     (see the AssetRipperGameHook removals above). Rebuild with the Ruri.Tpk project. -->
	<ItemGroup Condition="'$(PureRelease)' != 'true'">
		<EmbeddedResource Include="AssetRipperGameHook\TypeTree\RuriTypeTree.tpk">
			<LogicalName>RuriTypeTree.tpk</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<!-- Unity's built-in engine resources, straight from the Tpk repo's own CI (the same artifact
	     AssetRipper.AssemblyDumper.Downloader fetches). It replaces the copy frozen into the published
	     AssetRipper.SourceGenerated package, which is stale enough to predate the current container
	     format. Not game-specific, so it survives PureRelease. See EngineAssetsTpkHook. -->
	<ItemGroup>
		<EmbeddedResource Include="AssetRipperHook\EngineAssets\EngineAssets.tpk">
			<LogicalName>EngineAssets.tpk</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

</Project>
